# Copy to .env for local development (Go loads it on start).

APP_ENV=development
# APP_ENV=production

# Long random string (required in production, min 32 chars)
SESSION_SECRET=local-only-change-this-session-secret

# true on HTTPS (Render / production)
APP_SECURE_COOKIES=false

# Optional: override data file path
# DATA_FILE=data/app.json

# Listen address (Render injects PORT automatically)
# LISTEN_ADDR=:8080

# Optional extra CORS origins, comma-separated
# APP_CORS_ORIGINS=https://your-custom-domain.com

# --- SMTP (optional locally; required for registration in production) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Telegram Mini App + Stars ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
