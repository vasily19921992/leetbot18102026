+func allowOrigin(origin string) bool {
+	if origin == "" {
+		return false
+	}
+	// Same host as the public app (Render / custom domain) or local dev.
+	allowed := []string{
+		"http://localhost:5173",
+		"http://127.0.0.1:5173",
+		"http://localhost:8080",
+		"http://127.0.0.1:8080",
+		"https://leetbot18102026.onrender.com",
+	}
+	for _, a := range allowed {
+		if origin == a {
+			return true
+		}
+	}
+	// Optional extra origins via APP_CORS_ORIGINS=comma,separated
+	for _, extra := range strings.Split(os.Getenv("APP_CORS_ORIGINS"), ",") {
+		if strings.TrimSpace(extra) == origin {
+			return true
+		}
+	}
+	return false
+}
